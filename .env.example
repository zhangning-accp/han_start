# Copy to .env locally. Never share or commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_DAILY_LIMIT=30
AI_TIMEOUT_MS=8000
PORT=3210

# Set only when the listed proxy overwrites X-Real-IP with the actual client IP.
# For the documented loopback Nginx setup: HAN_TRUSTED_PROXIES=127.0.0.1
HAN_TRUSTED_PROXIES=

# Optional absolute path to a local country MMDB. Empty uses resources/geoip/country.mmdb.
# Country lookup uses clientAddress and never trusts arbitrary forwarded headers.
HAN_GEOIP_DB=
